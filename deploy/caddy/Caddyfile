# Caddyfile — 反代 backend (8080) + frontend (3000)
#
# 用法:
#   1. .env 里设 DOMAIN=yourdomain.com (必填,否则 Caddy 启动失败)
#   2. docker compose up -d (caddy 自动申请 Let's Encrypt 证书)
#   3. 公网访问 https://yourdomain.com → frontend;https://yourdomain.com/api/* → backend
#
# 设计决策:
#   - 只暴露 80/443,backend/frontend 不直接对外
#   - 自动 HTTPS(Caddy 内置 ACME 客户端)
#   - WS 反代到 /ws/*(WebSocket 握手 + Upgrade header)
#   - 后端 /health 反代到 /health(给外部监控用)
#   - /api/* 反代到 backend(保留原始 Host 头给 JWT cookie 用)

{$DOMAIN} {
    encode zstd gzip

    # v0.10.21 PR-E (P2-C2): access log 落地（按 100MB 滚动保留 5 份）
    # 触发: production-retrospective-2026-08-05.md §4 P2-1
    # 当前完全看不到真实 HTTP 流量（只有 frontend 后端反代，没法审计外部 IP / 4xx / 慢请求）
    # 卷挂载见 docker-compose.yml caddy 段：./logs/caddy:/data/caddy
    #
    # v2.13 修复：这里原写作 `access_log { ... }` —— Caddy v2.11.7 不认识该指令
    # （`caddy adapt` 报 "unrecognized directive: access_log"），容器起来后读完配置
    # 立即静默 exit 1 并无限重启（Restarts 一直涨、日志里没有任何 error，极难排查）。
    # Caddy v2 的站点级访问日志指令是 `log`。等价改写后 adapt 通过。
    log {
        output file /data/caddy/access.log {
            roll_size 100mb
            roll_keep 5
        }
    }

    # WebSocket 端点 → backend (gin)
    @websocket {
        path /ws/*
    }
    reverse_proxy @websocket backend:8080

    # /api/* 走 backend
    @api {
        path /api/*
    }
    reverse_proxy @api backend:8080

    # /health + /metrics → backend (供外部监控)
    @ops {
        path /health /metrics
    }
    reverse_proxy @ops backend:8080

    # ── 可观测面板（Grafana）→ /monitor/* ────────────────────────────────────
    # 2026-10-13：Grafana 此前只绑 127.0.0.1:3001（必须 SSH 隧道才能看）。这里把它挂到
    # 主域的 /monitor/ 路径下，免隧道；**两道口令**：① Caddy basicauth（外层，挡扫描器与
    # Grafana 的 pre-auth CVE）② Grafana 自身登录（内层，口令 = 服务器 .env 的 GF_ADMIN_PASSWORD）。
    #
    # 外层口令的变量**必填**（docker-compose.yml caddy 段用 ${OPS_BASIC_*:?} 把关），
    # 缺失时部署会在 compose 解析阶段直接失败 —— 刻意不让它静默降级成"页打不开但没报错"。
    #   .env:  OPS_BASIC_USER=<用户名>
    #          OPS_BASIC_HASH='<docker run --rm caddy:2-alpine caddy hash-password --plaintext "<口令>" 的输出>'
    #   ⚠️ 哈希必须单引号包住 —— 里面的 $ 会被 compose 当变量展开。
    #
    # Grafana 侧必须配套两项（见 docker-compose.yml grafana 段）：
    #   GF_SERVER_ROOT_URL=https://<DOMAIN>/monitor/  +  GF_SERVER_SERVE_FROM_SUB_PATH=true
    #   否则 Grafana 生成的资源/跳转链接不带 /monitor 前缀 → 页面 404 / 白屏。
    #   服务端子路径生效后，Caddy 这里**不做 strip_prefix**，原样透传。
    @monitor {
        path /monitor/*
    }
    basicauth @monitor {
        {$OPS_BASIC_USER} {$OPS_BASIC_HASH}
    }
    reverse_proxy @monitor grafana:3000

    # 其他全部 → frontend (Next.js)
    reverse_proxy frontend:3000
}